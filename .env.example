# Copy this file to .env and fill in your Sandbox app values.
# .env is loaded automatically at startup (shell exports take precedence)
# and is git-ignored — never commit real credentials.
# Get both values from a Sandbox app at https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PORT=3000
