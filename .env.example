# Copy this file to .env and fill in your Sandbox app values.
# .env is loaded automatically at startup (shell exports take precedence)
# and is git-ignored — never commit real credentials.
# Get both values from a Sandbox app at https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PORT=3000

# Optional — a real AI model for the language step. Set any ONE key:
# the sentence is then parsed by that model, and any failure falls
# back to the built-in offline rules parser. With no key at all, the
# rules parser handles every sentence.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Or a generic key plus provider/base overrides (OpenAI-compatible
# endpoints included):
# LLM_API_KEY=
# LLM_PROVIDER=openai|anthropic|gemini|openai-compatible
# LLM_MODEL=
# LLM_API_BASE=
# LLM_TIMEOUT_MS=8000
